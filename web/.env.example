# ── Supabase ────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # Server-side only, never expose to browser

# ── Blockchain ──────────────────────────────────────────────────────────────
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz/
VITE_AD_EXCHANGE_ADDRESS=0xd5183c7dc0de1596bddf1f61f7314f76b82502a54e25961e5c29b9560f469e48

# ── Relayer ──────────────────────────────────────────────────────────────────
# Hot wallet that signs openAuction / settleAuction transactions.
# Fund from https://faucet.monad.xyz/ — keep balance > 0.01 MON.
# Set as a Cloudflare secret (never commit the real value):
#   wrangler pages secret put RELAYER_PRIVATE_KEY
RELAYER_PRIVATE_KEY=0xd5183c7dc0de1596bddf1f61f7314f76b82502a54e25961e5c29b9560f469e48

# ── Cloudflare (wrangler) ───────────────────────────────────────────────────
# Only needed for deploy. Local dev uses the values above directly.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
