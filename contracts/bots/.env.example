# ── Bot wallet private keys ────────────────────────────────────────────────
# Fund each of these addresses from https://faucet.monad.xyz/ BEFORE the demo.
# Use 3 separate wallets — never reuse the relayer key.

BOT_PRIVATE_KEY_ACME=0x...   # Bot "acme" (blue creative)
BOT_PRIVATE_KEY_BUZZ=0x...   # Bot "buzz" (red creative)
BOT_PRIVATE_KEY_CORE=0x...   # Bot "core" (green creative)

# ── Contract & network ─────────────────────────────────────────────────────
AD_EXCHANGE_ADDRESS=0x...     # Filled in after forge script Deploy runs
MONAD_RPC_URL=https://testnet-rpc.monad.xyz/

# ── Bot tuning ─────────────────────────────────────────────────────────────
# Min/max bid range in ether (bots pick a random value in this range)
BOT_BID_MIN_ETH=0.010
BOT_BID_MAX_ETH=0.025

# Set to "scripted" for the demo run so bots bid deterministically,
# or "random" for test runs so the outcome doesn't look staged.
BOT_MODE=random
